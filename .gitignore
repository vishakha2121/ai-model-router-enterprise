# Navigate to project
cd C:\Users\HP\ai-model-router

# Check current status
git status

# Add .gitignore
git add .gitignore

# Add any other files that were missed
git add .

# Commit with message
git commit -m "🔒 Add comprehensive .gitignore file

- Python bytecode and cache files
- Node modules and build files
- IDE configuration files
- Operating system files
- Database files
- Environment variables
- Sensitive data and keys
- Temporary and backup files"

# Push to GitHub
git push -u origin main

# Check status
git status
